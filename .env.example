# @worlds/sdk provider
# No external API keys required — uses file-backed LibSQL for local eval runs.

# Judge / answering model (required for full pipeline)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Also supported by the Google AI SDK:
# GOOGLE_GENERATIVE_AI_API_KEY=

# DeepSeek (first-class answering model, judge, and fact extractor)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: override judge model via CLI
# bun run src/index.ts run -p worlds -b locomo -l 5 -j deepseek-v4-flash -m gpt-4o

# --- Worlds provider tuning ---
# WorldsProvider uses the local, CPU-friendly TF.js Universal Sentence Encoder Lite adapter.
# Download its ignored, reusable weights once with: bun run models:tfjs-use
# The default location is data/models/tfjs-use; override with TFJS_USE_MODEL_DIR.
TFJS_USE_MODEL_DIR=

# Fact extraction: 'deepseek' (default), 'gemini', or 'openai'.
#   'deepseek' uses DEEPSEEK_API_KEY + DEEPSEEK_BASE_URL; 'none' disables extraction.
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=

# Shared content-addressed cache lives under data/cache/ (embeddings + extraction).
# Reset it explicitly with: bun run src/index.ts cache-clear
