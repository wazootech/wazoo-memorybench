# @worlds/sdk provider
# Local file-backed SQLite graph + TFJS USE embeddings (no embedding API needed).
# DeepSeek powers fact extraction and is the default judge/answering model.

# Judge / answering model (required for full pipeline)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Also supported by the Google AI SDK:
# GOOGLE_GENERATIVE_AI_API_KEY=

# DeepSeek (fact extractor, default judge, and default answering model)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: override judge model via CLI
# bun run src/index.ts run -p worlds -b locomo -l 5   (defaults: DeepSeek judge + answers)

# --- Worlds provider tuning ---
# WorldsProvider uses the local, CPU-friendly TF.js Universal Sentence Encoder Lite adapter.
# Download its ignored, reusable weights once with: bun run models:tfjs-use
# The default location is data/models/tfjs-use; override with TFJS_USE_MODEL_DIR.
TFJS_USE_MODEL_DIR=

# Fact extraction: DeepSeek only (default); set to 'none' to disable extraction.
#   DeepSeek uses DEEPSEEK_API_KEY + DEEPSEEK_BASE_URL.
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=

# Shared content-addressed cache lives under data/cache/ (embeddings + extraction).
# Reset it explicitly with: bun run src/index.ts cache-clear
